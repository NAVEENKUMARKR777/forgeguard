{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": [
    "worker-configuration.d.ts",
    "types/env-extra.d.ts",
    "evals/**/*.ts",
    "tests/**/*.ts",
    "policy/load-node.ts",
    "policy/engine.ts",
    "policy/schema.ts",
    "risk/engine.ts",
    "mcp/types.ts",
    "mcp/github.ts",
    "mcp/cicd.ts",
    "mcp/registry.ts",
    "mcp/tool-metadata.ts",
    "memory/incidents.ts",
    "memory/engineering.ts",
    "memory/audit.ts",
    "audit/**/*.ts",
    "observability/**/*.ts",
    "incident/**/*.ts",
    "remediation/**/*.ts",
    "workflows/idempotent-create.ts",
    "context/**/*.ts",
    "gitops/**/*.ts",
    "types/gitops.ts",
    "productivity/**/*.ts",
    "types/productivity.ts",
    "evals/**/*.json"
  ],
  "exclude": ["evals/history-api.ts"]
}
